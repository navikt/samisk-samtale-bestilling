{
    "name": "samisk-samtale-bestilling",
    "version": "3.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "start": "node --env-file-if-exists=.env dist/server.js",
        "start-local": "cp .env.local-prod .env && pnpm run build && pnpm run start",
        "dev": "cp .env.development .env && tsx watch --env-file=.env dev/dev-server.ts",
        "mock": "tsx dev/mock-upstream.ts",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
        "lint": "oxlint",
        "format": "oxfmt src dev tests static vitest.config.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.0",
        "@navikt/nav-dekoratoren-moduler": "4.2.2",
        "csp-header": "6.3.1",
        "hono": "^4.7.0",
        "html-react-parser": "6.1.5",
        "react": "19.2.4"
    },
    "devDependencies": {
        "@types/node": "26.1.2",
        "html-validate": "^9.5.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "tsx": "^4.19.0",
        "typescript": "6.0.3",
        "vitest": "^3.1.0"
    },
    "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
