{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2023"],
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src"]
}
